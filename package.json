{
  "name": "bling-launcher",
  "productName": "Bling Launcher",
  "version": "1.18.1",
  "private": true,
  "description": "Launcher de escritorio del ecosistema Bling: todos los servicios en una sola app.",
  "repository": {
    "type": "git",
    "url": "https://github.com/services-blingcompany/launcher.git"
  },
  "author": "Bling Company",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && node scripts/inyectar-credenciales.cjs && electron-builder --win --publish never",
    "local:build": "npm run build && node scripts/inyectar-credenciales.cjs && electron-builder --win --dir --publish never && node scripts/ensure-app-update-yml.mjs",
    "local": "taskkill /F /IM \"Bling Launcher.exe\" /T >nul 2>&1 & npm run local:build && start \"\" \"release\\win-unpacked\\Bling Launcher.exe\"",
    "start": "npm run build && electron .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "uy.blingcompany.launcher",
    "productName": "Bling Launcher",
    "artifactName": "Bling-Launcher-Setup-${version}.exe",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/icon.ico",
      "assets/tray-icon.png",
      "assets/BlingBellNoBg.png"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "services-blingcompany",
      "repo": "launcher"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bling Launcher",
      "deleteAppDataOnUninstall": false
    }
  }
}
